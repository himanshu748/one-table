# Frontend: emitted by npx convex dev. This URL is public, not a secret.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Backend only: set with npx convex env set NAME (reads the value from stdin).
# FIRECRAWL_API_KEY
# OPENAI_API_KEY, or AI_GATEWAY_API_KEY for the fixed OpenAI provider route
# AGENTMAIL_API_KEY: scoped to the dedicated One Table inbox
# AGENTMAIL_INBOX_ID
# AGENTMAIL_WEBHOOK_SECRET: Svix signing secret, not an arbitrary shared string
# PUBLIC_SENDING_ENABLED: true enables limited enquiries for verified accounts; false pauses them
# PILOT_RECIPIENTS: optional controlled test recipients allowed for guest sessions
# JWT_PRIVATE_KEY, JWKS, SITE_URL: configured by @convex-dev/auth

# SITE_URL must be the public frontend origin (or local origin while developing).
# Operator scripts use explicit shell-only configuration:
# WEBHOOK_ORIGIN=https://your-deployment.convex.site
# QA_THREAD_ID and QA_SENDER identify an owned test thread for check-webhook.mjs.
